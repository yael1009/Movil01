<ContentPage x:Class="Movil01.MainPage" Title="Calculadora">
<Grid Padding="16" RowSpacing="12" RowDefinitions="*,Auto">
    <VerticalStackLayout Grid.row="0" VerticalOptions="End" HorizontalOptions="End" >
        <Label Text="{Binding Expression}" FontSize="20" TextColor="Gray"></Label>
        <Label Text ="{Binding Display}" FontSize="67" HorizontalTextAlignment="End"
            LineBreakMode="TailTruncation" MaxLines="1"></Label>
    </VerticalStackLayout>

    <Grid Grid.Row="1" RowSpacing="8" ColumnSpacing="8" 
        RowDefinitions="72,72,72,72,72" ColumnDefinitions="*,*,*,*">
        <Button Grid.row ="0" Grid.Column="0"Text="C" Command="{Binding Clear}"
            BackgroundColor="#D4D4D2" TextColor="Black" FontSize="26" ></Button>
        <Button Grid.row ="0" Grid.Column="1"Text="C" Command="{Binding Clear}"
            BackgroundColor="#D4D4D2" TextColor="Black" FontSize="26" ></Button>
        <Button Grid.row ="0" Grid.Column="2"Text="C" Command="{Binding Clear}"
            BackgroundColor="#D4D4D2" TextColor="Black" FontSize="26" ></Button>
        <Button Grid.row ="0" Grid.Column="3"Text="C" Command="{Binding Clear}"
            BackgroundColor="#D4D4D2" TextColor="Black" FontSize="26" ></Button>
        <Button Grid.row ="0" Grid.Column="0"Text="C" Command="{Binding Clear}"
            BackgroundColor="#D4D4D2" TextColor="Black" FontSize="26" ></Button>
        <Button Grid.row ="1" Grid.Column="0"Text="C" Command="{Binding Clear}"
            BackgroundColor="#D4D4D2" TextColor="Black" FontSize="26" ></Button>
        <Button Grid.row ="1" Grid.Column="1"Text="C" Command="{Binding Clear}"
            BackgroundColor="#D4D4D2" TextColor="Black" FontSize="26" ></Button>
        <Button Grid.row ="1" Grid.Column="2"Text="C" Command="{Binding Clear}"
            BackgroundColor="#D4D4D2" TextColor="Black" FontSize="26" ></Button>
        <Button Grid.row ="1" Grid.Column="3"Text="C" Command="{Binding Clear}"
            BackgroundColor="#D4D4D2" TextColor="Black" FontSize="26" ></Button>
        <Button Grid.row ="0" Grid.Column="0"Text="C" Command="{Binding Clear}"
            BackgroundColor="#D4D4D2" TextColor="Black" FontSize="26" ></Button>
        <Button Grid.row ="0" Grid.Column="0"Text="C" Command="{Binding Clear}"
            BackgroundColor="#D4D4D2" TextColor="Black" FontSize="26" ></Button>
        <Button Grid.row ="0" Grid.Column="0"Text="C" Command="{Binding Clear}"
            BackgroundColor="#D4D4D2" TextColor="Black" FontSize="26" ></Button>
        <Button Grid.row ="0" Grid.Column="0"Text="C" Command="{Binding Clear}"
            BackgroundColor="#D4D4D2" TextColor="Black" FontSize="26" ></Button>
</Grid>

</ContentPage>
